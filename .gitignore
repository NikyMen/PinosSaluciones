# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.uploads/

# material crudo con datos reales de clientes (ver docs/README.md)
docs/_inbox/*
!docs/_inbox/LEEME.md

# base de datos local de desarrollo (scripts/dev.mjs)
.mongo-data/

# Obsidian: se comparte la config de la vault, no el estado local de cada uno
docs/.obsidian/workspace*
docs/.obsidian/cache
docs/.obsidian/graph.json

# acceso directo con ruta absoluta, propio de cada máquina
*.url

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# config real de nginx del servidor (se versiona solo nginx.conf.example)
deploy/*.nginx.conf

# pruebas locales del generador de PDF
pdf-check.ts
.pdf-preview.pdf
