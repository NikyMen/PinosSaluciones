# Local: mongodb://127.0.0.1:27017/pinos_erp
# VPS (Mongo local): mongodb://usuario:clave@127.0.0.1:27017/pinos_erp?authSource=admin
# VPS (Mongo remoto/Atlas): mongodb+srv://usuario:clave@cluster.example/pinos_erp
MONGODB_URI=mongodb://127.0.0.1:27017/pinos_erp
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
SESSION_SECRET=cambiar-por-un-secreto-largo-y-unico
APP_URL=http://localhost:3000
# En produccion, usar la URL publica con HTTPS. PM2 usa 3515 por defecto.
# PORT=3515
UPLOAD_DIR=./.uploads
ADMIN_EMAIL=admin@pinos.local
ADMIN_PASSWORD=Cambiar123!
WORKER_INTERVAL_MS=60000
DEEPSEEK_API_KEY=pegá-tu-api-key-de-deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# Credenciales OAuth de Google Cloud Console (tipo "Aplicación web"), para el módulo de Agenda.
# Redirect URI a autorizar: <APP_URL>/api/calendar/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Correo saliente (invitaciones de usuarios y links para cambiar la contraseña).
# Sirve cualquier casilla con SMTP: la del dominio, Gmail con "contraseña de aplicación", Brevo, etc.
# Sin SMTP_HOST no se manda nada: al crear un usuario se muestra el link para copiarlo y mandarlo a mano.
# Los links usan APP_URL, que en produccion tiene que ser la URL publica (https://...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true para el puerto 465 (TLS directo); si se deja vacio se deduce del puerto.
SMTP_SECURE=
MAIL_FROM="Pino Soluciones <no-responder@tu-dominio.com>"
# Factura electrónica de ARCA (web services). Carpeta FUERA del repo con <empresa>.crt y <empresa>.key
# (constructora.crt/.key, tvp.crt/.key). Sin los archivos, la empresa figura como no conectada.
ARCA_CERT_DIR=
# produccion (por defecto) u homologacion (ambiente de prueba, con certificados propios de ahí).
ARCA_ENV=
# Factura electronica ARCA (WSAA + WSFEv1). Carpeta FUERA del repo con el certificado de cada
# empresa (alias "pinosoluciones" en ARCA): constructora.crt/.key y tvp.crt/.key, con permisos 600.
# Sin la carpeta o sin los archivos de una empresa, esa empresa no se conecta. Necesita openssl.
ARCA_CERT_DIR=
# produccion (por defecto) u homologacion (prueba; requiere certificados sacados en WSASS)
ARCA_ENV=produccion
