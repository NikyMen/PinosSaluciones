# El HTTPS lo termina Traefik en :443 (ver deploy/traefik-pinosoluciones.yml).
# Nginx solo tiene el :80 y redirige. Si desplegas en un VPS donde Nginx si es
# dueno del :443, reemplaza este bloque por un proxy_pass y emiti el cert con
# Certbot; en ese caso el proxy tiene que apuntar a 127.0.0.1:3515.
server {
    listen 80;
    listen [::]:80;
    server_name gestion.ejemplo.com;
    return 301 https://$host$request_uri;
}
